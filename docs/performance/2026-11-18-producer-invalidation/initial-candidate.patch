+impl ProducerIndex {
+    pub(super) fn new(registrations: &BTreeMap<(ScopeId, u64), Registration>) -> Self {
+        let mut index: BTreeMap<_, BTreeSet<_>> = BTreeMap::new();
+        for (&key, registration) in registrations {
